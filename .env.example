# ==== Ollama (embedding 本地) ====
OLLAMA_BASE_URL=http://localhost:11434
# 备选: qwen3-embedding:0.6b (639MB) / :4b (2.5GB) / :8b (4.7GB)
EMBEDDING_MODEL=qwen3-embedding:4b

# ==== DeepSeek 官方 API (对话生成) ====
# API Key 从系统环境变量读取（在 https://platform.deepseek.com 申请）:
#   export RAG_DEEPSEEK_API_KEY=sk-xxx
# flash 档用 deepseek-chat; 深度推理用 deepseek-reasoner
CHAT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ==== Postgres (pgvector) ====
# 注意必须用 +psycopg (psycopg3)
PG_URL=postgresql+psycopg://rag:rag123456@localhost:5432/ragdb
# 向量表名（按 embedding 模型区分，换模型不冲突）
TABLE_NAME=docs_qwen3_embedding_4b

# 本地服务不走系统代理
NO_PROXY=localhost,127.0.0.1

# ==== RAG ====
DOCS_DIR=data
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
